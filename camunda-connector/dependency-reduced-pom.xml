<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>net.patrykdobrowolski.camunda</groupId>
  <artifactId>camunda-connector</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <build>
    <finalName>camunda-connector</finalName>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${version.lombok}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>io.camunda.connector</groupId>
        <artifactId>element-template-generator-maven-plugin</artifactId>
        <version>${version.camunda-connector}</version>
        <executions>
          <execution>
            <goals>
              <goal>generate-templates</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <connectors>
            <connector>
              <connectorClass>net.patrykdobrowolski.camunda_connector.flight.FlightServiceConnector</connectorClass>
            </connector>
            <connector>
              <connectorClass>net.patrykdobrowolski.camunda_connector.payment.PaymentServiceOutboundConnector</connectorClass>
            </connector>
            <connector>
              <connectorClass>net.patrykdobrowolski.camunda_connector.payment.PaymentServiceInboundConnector</connectorClass>
            </connector>
          </connectors>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <relocations>
                <relocation>
                  <pattern>org.slf4j</pattern>
                  <shadedPattern>shadow.org.slf4j</shadedPattern>
                </relocation>
              </relocations>
              <transformers>
                <transformer />
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <repositories>
    <repository>
      <id>central</id>
      <url>https://repo.maven.apache.org/maven2</url>
    </repository>
  </repositories>
  <dependencies>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>1.18.44</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <version.lombok>1.18.44</version.lombok>
    <version.jackson>2.22.0</version.jackson>
    <version.camunda-connector>8.9.6</version.camunda-connector>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <version.jakarta-validation>4.0.0-M1</version.jakarta-validation>
  </properties>
</project>
