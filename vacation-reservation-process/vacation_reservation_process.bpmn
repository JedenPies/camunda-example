    <bpmn:serviceTask id="Activity_0xx422l" name="Retrieve Offer" zeebe:modelerTemplate="retrieve-offer-custom-connector">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="=offerId" target="localOfferId" />
          <zeebe:input source="GET" target="method" />
          <zeebe:input source="=&#34;http://external-services:8080/api/offers/&#34; + localOfferId" target="url" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression" value="={&#34;offer&#34;: response.body}" />
          <zeebe:header key="errorExpression" value="=if error.code = &#34;404&#34; then bpmnError(&#34;OFFER_NOT_FOUND&#34;, &#34;No offer&#34;) else null" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
