    <bpmn:serviceTask id="Activity_1xsx06x" name="Reserve Flight" zeebe:modelerTemplate="reserve-flight-connector" zeebe:modelerTemplateVersion="0">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="net.patrykdobrowolski:reserve-flight:1" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="operation" value="reserve-flight" />
          <zeebe:header key="elementTemplateVersion" value="0" />
          <zeebe:header key="elementTemplateId" value="reserve-flight-connector" />
          <zeebe:header key="resultVariable" value="flightReservationResult" />
          <zeebe:header key="resultExpression" value="=body" />
          <zeebe:header key="errorExpression" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=flightId" target="flightId" />
          <zeebe:input source="=3" target="seats" />
