    <bpmn:serviceTask id="Activity_17ho8he" name="Reserve hotel" zeebe:modelerTemplate="io.camunda.connectors.RabbitMQ.v1" zeebe:modelerTemplateVersion="6" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:connector-rabbitmq:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="credentials" target="authentication.authType" />
          <zeebe:input source="guest" target="authentication.userName" />
          <zeebe:input source="guest" target="authentication.password" />
          <zeebe:input source="hotel_reservation" target="routing.exchange" />
          <zeebe:input source="=&#34;request.&#34; + hotelId" target="routing.routingKey" />
          <zeebe:input source="/" target="routing.virtualHost" />
          <zeebe:input source="rabbitmq" target="routing.hostName" />
          <zeebe:input source="5672" target="routing.port" />
          <zeebe:input source="={}" target="message.properties" />
          <zeebe:input source="={&#10;  &#34;correlationKey&#34;: processKey,&#10;  &#34;hotelId&#34;: hotelId&#10;}" target="message.body" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="6" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.RabbitMQ.v1" />
          <zeebe:header key="resultVariable" />
          <zeebe:header key="resultExpression" />
          <zeebe:header key="errorExpression" />
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08nqexk</bpmn:incoming>
      <bpmn:outgoing>Flow_1uii30m</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Event_0kprg3w" name="Receive reservation result" zeebe:modelerTemplate="io.camunda.connectors.inbound.RabbitMQ.Intermediate.v1" zeebe:modelerTemplateVersion="8" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:properties>
          <zeebe:property name="inbound.type" value="io.camunda:connector-rabbitmq-inbound:1" />
          <zeebe:property name="authentication.authType" value="credentials" />
          <zeebe:property name="authentication.userName" value="guest" />
          <zeebe:property name="authentication.password" value="guest" />
          <zeebe:property name="routing.virtualHost" value="/" />
          <zeebe:property name="routing.hostName" value="rabbitmq" />
          <zeebe:property name="routing.port" value="5672" />
          <zeebe:property name="queueName" value="hotel_reservation_response" />
          <zeebe:property name="consumerTag" value="" />
          <zeebe:property name="exclusive" value="false" />
          <zeebe:property name="consumeUnmatchedEvents" value="true" />
          <zeebe:property name="correlationKeyExpression" value="=message.body.correlationKey" />
          <zeebe:property name="deduplicationModeManualFlag" value="false" />
          <zeebe:property name="deduplicationMode" value="AUTO" />
          <zeebe:property name="resultVariable" value="rabbitResult" />
          <zeebe:property name="resultExpression" value="=response.body.correlationKey" />
        </zeebe:properties>
      </bpmn:extensionElements>
